# .intent/agents.toml  (or ~/.intent/agents.toml)
#
# 99% of users NEVER need this file.
#
# Only create it when you want:
# - to run a command that requires shell activation (conda, venv, nvm, direnv…)
# - to always pass the same extra flags
# - to give a short memorable name to a long command
#
# For everything else, just do:
#   il run cursor
#   il run claude
#   il run kimi
#   … and it will use whatever is already in your PATH with your full environment.

[agents.cursor]
command = "cursor"
args = []
shell_setup = "source .venv/bin/activate || true"
# env_whitelist is OPTIONAL and only needed if you want to *selectively* pass
# variables that are NOT already present in your normal shell environment.
# In 99% of cases you can leave this empty or omit it entirely.
env_whitelist = []

[agents.claude]
command = "claude"
args = []
shell_setup = ""
env_whitelist = []

# Example for GitHub Copilot CLI (one-shot style)
[agents.copilot]
command = "gh"
args = ["copilot", "suggest"]
# prompt_template is used by `intent copilot` when you don't pass --prompt
prompt_template = "{prompt}"
env_whitelist = []
